{
  "manifest_version": 3,
  "name": "YouTube 双语字幕（本地）",
  "version": "0.1.0",
  "description": "在 YouTube 播放器上叠加原文 + 译文的双语字幕，翻译走你自己配置的 OpenAI 兼容接口。",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "YouTube 双语字幕",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://clients5.google.com/*",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-bilingual": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "切换当前 YouTube 视频的双语字幕"
    }
  }
}
